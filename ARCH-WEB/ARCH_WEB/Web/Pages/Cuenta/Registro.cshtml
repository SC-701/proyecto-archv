@page
@model Web.Pages.Cuenta.RegistroModel
@{
    Layout = null;
    ViewData["Title"] = "Registrarse";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ARCHV</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Web.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        html, body {
            height: 100% !important;
            margin: 0 !important;
            background: url('/images/fondo-login.png') center center / cover no-repeat fixed !important;
            background-color: #000 !important;
        }

        body {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
        }

        .card-auth {
            max-width: 420px;
            width: 100%;
            background: rgba(17,17,17,.92);
            border-radius: 1rem;
        }
    </style>
</head>
<body>

    <div class="card card-auth shadow-lg border-0 text-light">
        <div class="card-body p-4 p-md-5">
            <div class="text-center mb-3">
                <img src="~/images/logo.png" alt="ARCHV Logo" class="img-fluid mb-3" style="max-height:60px;">
                <h2 class="text-uppercase mb-1">Registrarse</h2>
                <p class="text-muted small">Crea tu cuenta para continuar</p>
            </div>

            <form method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <!-- Usuario -->
                <div class="mb-3">
                    <label class="form-label">Nombre de usuario</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-secondary text-white border-0"><i class="bi bi-person-fill"></i></span>
                        <input asp-for="usuario.NombreUsuario" placeholder="Tu nombre de usuario"
                               class="form-control bg-dark text-light border-0" />
                    </div>
                    <span asp-validation-for="usuario.NombreUsuario" class="text-danger small"></span>
                </div>

                <!-- Correo -->
                <div class="mb-3">
                    <label class="form-label">Correo electrónico</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-secondary text-white border-0"><i class="bi bi-envelope-at-fill"></i></span>
                        <input asp-for="usuario.CorreoElectronico" type="email" placeholder="nombre@dominio.com"
                               class="form-control bg-dark text-light border-0" />
                    </div>
                    <span asp-validation-for="usuario.CorreoElectronico" class="text-danger small"></span>
                </div>

                <!-- Contraseña -->
                <div class="mb-3">
                    <label class="form-label">Contraseña</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-secondary text-white border-0"><i class="bi bi-key-fill"></i></span>
                        <input asp-for="usuario.Password" type="password" id="pass"
                               placeholder="••••••••"
                               class="form-control bg-dark text-light border-0" />
                        <button type="button" class="btn btn-outline-light border-0 toggle-pass" data-target="pass"><i class="bi bi-eye"></i></button>
                    </div>
                    <span asp-validation-for="usuario.Password" class="text-danger small"></span>
                </div>

                <!-- Confirmar Contraseña -->
                <div class="mb-3">
                    <label class="form-label">Confirmar contraseña</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-secondary text-white border-0"><i class="bi bi-key-fill"></i></span>
                        <input asp-for="usuario.ConfirmarPassword" type="password" id="confirmar"
                               placeholder="Repite tu contraseña"
                               class="form-control bg-dark text-light border-0" />
                        <button type="button" class="btn btn-outline-light border-0 toggle-pass" data-target="confirmar"><i class="bi bi-eye"></i></button>
                    </div>
                    <span asp-validation-for="usuario.ConfirmarPassword" class="text-danger small"></span>
                </div>

                <!-- Checkbox -->
                <div class="form-check d-flex justify-content-center mb-4">
                    <input class="form-check-input me-2" type="checkbox" id="aceptar" />
                    <label for="aceptar" class="form-check-label small">
                        He leído y acepto <a href="#!" class="link-light text-decoration-none">los términos y condiciones</a>
                    </label>
                </div>

                <!-- Botón -->
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg">Registrarse</button>
                </div>
            </form>

            <hr class="my-4 border-secondary opacity-50" />
            <div class="d-flex gap-3 justify-content-center">
                <a href="./login" class="link-light text-decoration-none">¿Ya tienes cuenta? Inicia sesión</a>
                <a href="#" class="link-light text-decoration-none">Ayuda</a>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.querySelectorAll('.toggle-pass').forEach(btn => {
          btn.addEventListener('click', function () {
            const input = document.getElementById(this.dataset.target);
            const icon = this.querySelector('i');
            if (input.type === "password") {
                input.type = "text";
                icon.classList.replace("bi-eye", "bi-eye-slash");
            } else {
                input.type = "password";
                icon.classList.replace("bi-eye-slash", "bi-eye");
            }
          });
        });
    </script>
</body>
</html>
