@page
@model Web.Pages.Cuenta.LoginModel
@{
    Layout = null;                      // ← sin header/footer
    ViewData["Title"] = "Iniciar sesión";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ARCHV</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Web.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        /* fuerza fondo a pantalla completa */
        html, body {
            height: 100% !important;
            margin: 0 !important;
            background: url('/images/fondo-login.png') center center / cover no-repeat fixed !important;
            background-color: #000 !important; /* fallback oscuro */
        }
        /* centrar tarjeta */
        body {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
        }

        .card-auth {
            max-width: 420px;
            width: 100%;
            background: rgba(17,17,17,.92);
            border-radius: 1rem;
        }
    </style>
</head>
<body>

    <div class="card card-auth shadow-lg border-0 text-light">
        <div class="card-body p-4 p-md-5">
            <div class="text-center mb-3">
                <img src="~/images/logo.png" alt="ARCHV Logo" class="img-fluid mb-3" style="max-height:60px;">
                <h2 class="text-uppercase mb-1">Iniciar sesión</h2>
                <p class="text-muted small mb-0">Ingresa tus credenciales para continuar</p>
            </div>

            <form method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <!-- Correo -->
                <div class="mb-3">
                    <label class="form-label" for="correo">Correo electrónico</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-secondary text-white border-0"><i class="bi bi-envelope-at"></i></span>
                        <input id="correo" type="email" placeholder="nombre@dominio.com"
                               asp-for="loginInfo.CorreoElectronico"
                               class="form-control bg-dark text-light border-0" autocomplete="username" />
                    </div>
                    <span asp-validation-for="loginInfo.CorreoElectronico" class="text-danger small"></span>
                </div>

                <!-- Contraseña -->
                <div class="mb-3">
                    <label class="form-label" for="pass">Contraseña</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-secondary text-white border-0"><i class="bi bi-key"></i></span>
                        <input id="pass" type="password" placeholder="••••••••"
                               asp-for="loginInfo.Password"
                               class="form-control bg-dark text-light border-0" autocomplete="current-password" />
                        <button class="btn btn-outline-light border-0" type="button" id="togglePass" aria-label="Mostrar/ocultar"><i class="bi bi-eye"></i></button>
                    </div>
                    <span asp-validation-for="loginInfo.Password" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="rememberMe" />
                        <label class="form-check-label small" for="rememberMe">Recordarme</label>
                    </div>
                    <a href="#" class="link-light small text-decoration-none">¿Olvidaste tu contraseña?</a>
                </div>

                @if (Model.token is not null && Model.token.ValidacionExitosa == false)
                {
                    <div class="alert alert-warning py-2 small mb-3">Credenciales incorrectas.</div>
                }

                <div class="d-grid"><button class="btn btn-primary btn-lg" type="submit">Iniciar sesión</button></div>
            </form>

            <hr class="my-4 border-secondary opacity-50" />
            <div class="d-flex gap-3 justify-content-center">
                <a href="./registro" class="link-light text-decoration-none">Registrarse</a>
                <a href="#" class="link-light text-decoration-none">Ayuda</a>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function(){
          const btn = document.getElementById('togglePass');
          const input = document.getElementById('pass');
          if(btn && input){
            btn.addEventListener('click', function(){
              const isPwd = input.type === 'password';
              input.type = isPwd ? 'text' : 'password';
              this.innerHTML = isPwd ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
            });
          }
        })();
    </script>
</body>
</html>
