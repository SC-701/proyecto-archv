@page
@model Web.Pages.Clientes.IndexModel
@{
    ViewData["Title"] = "Clientes";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

<header class="subhead">
    <div class="container text-center">
        <h1 class="masthead-heading text-uppercase text-light">Lista de Clientes</h1>
    </div>
</header>

<section class="py-4">
    <div class="container">
        <div class="text-start mb-4">
            <a class="btn btn-success btn-lg" asp-page="./Agregar">
                <i class="fa-solid fa-square-plus me-1"></i> Agregar
            </a>
        </div>

        <div class="row g-4">
            @if (Model.clientes != null && Model.clientes.Any())
            {
                @foreach (var cliente in Model.clientes)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card bg-dark text-light shadow-sm rounded-4 border-0 h-100">
                            <div class="card-body p-4 d-flex flex-column">
                                <h5 class="fw-bold mb-2">
                                    <i class="fa-solid fa-user me-2"></i>@cliente.Nombre @cliente.Apellidos
                                </h5>

                                <div class="mb-1 text-secondary small">
                                    <i class="fa-solid fa-mobile me-2"></i>
                                    <strong>Teléfono:</strong> @cliente.Telefono
                                </div>
                                <div class="mb-3 text-secondary small">
                                    <i class="fa-solid fa-location-dot me-2"></i>
                                    <strong>Dirección:</strong> @cliente.Provincia, @cliente.DireccionExacta
                                </div>

                                <div class="mt-auto pt-3 border-top border-secondary-subtle d-flex gap-2">
                                    <a class="btn btn-outline-warning btn-sm" asp-page="./Editar" asp-route-id="@cliente.Id"
                                       title="Editar">
                                        <i class="fa-solid fa-user-pen"></i>
                                    </a>
                                    <a class="btn btn-outline-danger btn-sm" asp-page="./Eliminar" asp-route-id="@cliente.Id"
                                       title="Eliminar">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="alert alert-warning">No hay clientes disponibles.</div>
                </div>
            }
        </div>
    </div>
</section>
