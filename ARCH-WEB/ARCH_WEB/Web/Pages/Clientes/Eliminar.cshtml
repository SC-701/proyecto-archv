@page
@model Web.Pages.Clientes.EliminarModel
@{
}

<section id="principal">
    <div class="container py-5">
        <div class="col-xl-6 col-lg-7 col-md-9 col-sm-12 mx-auto">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-5">
                    <h4 class="mb-4 text-center text-danger">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        ¿Está seguro que desea eliminar este cliente?
                    </h4>

                    <form method="post">
                        <ul class="list-group list-group-flush mb-4">
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <strong><i class="bi bi-person-fill me-1"></i> Nombre:</strong>
                                <span>@Model.cliente.Nombre</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <strong><i class="bi bi-person-lines-fill me-1"></i> Apellidos:</strong>
                                <span>@Model.cliente.Apellidos</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <strong><i class="bi bi-telephone-fill me-1"></i> Teléfono:</strong>
                                <span>@Model.cliente.Telefono</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <strong><i class="bi bi-geo-alt-fill me-1"></i> Provincia:</strong>
                                <span>@Model.cliente.Provincia</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <strong><i class="bi bi-house-fill me-1"></i> Dirección:</strong>
                                <span>@Model.cliente.DireccionExacta</span>
                            </li>
                        </ul>

                        <div class="d-flex justify-content-between">
                            <a class="btn btn-outline-primary rounded-pill px-4" asp-page="./Index">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-outline-danger rounded-pill px-4">
                                <i class="bi bi-trash-fill me-1"></i> Eliminar
                            </button>
                        </div>

                        <input type="hidden" asp-for="cliente.Id" />
                        <input type="hidden" asp-for="cliente.Nombre" />
                        <input type="hidden" asp-for="cliente.Apellidos" />
                        <input type="hidden" asp-for="cliente.Telefono" />
                        <input type="hidden" asp-for="cliente.Provincia" />
                        <input type="hidden" asp-for="cliente.DireccionExacta" />
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
