@page
@model Web.Pages.Apartado.IndexModel
@{
    ViewData["Title"] = "Apartados";
}

<div class="container mt-4">
    <h2 class="mb-4">Listado de Apartados</h2>

    <a asp-page="Crear" class="btn btn-success mb-3">+ Nuevo Apartado</a>

    @if (Model.apartados != null && Model.apartados.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Cliente</th>
                        <th>Producto</th>
                        <th>Precio</th>
                        <th>Abono</th>
                        <th>Restante</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.apartados)
                    {
                        <tr>
                            <td>@item.Cliente</td>
                            <td>@item.Producto</td>
                            <td>₡@item.PrecioProducto</td>
                            <td>₡@item.Abono</td>
                            <td>₡@item.Restante</td>
                            <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@item.Estado</td>
                            <td class="text-center">
                                <a asp-page="Detalles" asp-route-id="@item.Id" class="btn btn-info btn-sm">Detalles</a>
                                <a asp-page="Editar" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Editar</a>
                                <a asp-page="Eliminar" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-warning">No hay apartados registrados.</div>
    }
</div>
