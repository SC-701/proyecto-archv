@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}



<section class="hero d-flex align-items-center justify-content-center text-center text-light">
    <div class="overlay"></div>
    <div class="content">
        <h1 class="metal-text">ARCHV</h1>
        <p class="lead">Ropa de segunda mano con estilo urbano y sostenible</p>
        <a asp-page="/Productos/Index" class="btn btn-light btn-lg mt-3">Explorar Productos</a>
    </div>
</section>



<style>
    
    .hero {
        position: relative;
        height: 85vh;
        background: url('/images/index.jfif') center center/cover no-repeat;
        border-bottom: 2px solid #2a2a2e;
    }

        .hero .overlay {
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,0.55); /* oscurece la imagen */
        }

        .hero .content {
            position: relative;
            z-index: 2;
            max-width: 700px;
        }

        .hero h1 {
            font-size: 4rem;
            margin-bottom: 1rem;
        }

        .hero p {
            font-size: 1.25rem;
            font-weight: bold;
        }

    .btn-lg {
        border-radius: .75rem;
        padding: .75rem 2rem;
    }
</style>
